# -*- mode: python ; coding: utf-8 -*-
"""
PyInstaller spec for RAAT-Pack v3 on macOS.  Written for PyInstaller 6.x.

Build (from the repository, on a Mac):
    cd RAATPackv3/frontend && npm ci && npm run build
    cd ../backend && pip install -e ".[desktop]"
    cd ../build && python make_icon.py && pyinstaller --noconfirm --clean raatpack_mac.spec
Produces build/dist/RAATPack.app — double-clickable, no terminal.

Or just run ./build_mac.sh, which does all of the above and checks the prerequisites first.

This is the sibling of raatpack.spec (Windows). The differences that matter:
  * BUNDLE() wraps the collected folder into the .app that Finder and the Dock understand.
  * pywebview talks to the system WebKit through pyobjc rather than Edge WebView2, so the
    hidden imports are the cocoa backend and its frameworks instead of winforms/pythonnet.
  * The icon is an .icns, generated by make_icon.py.

Not signed or notarised. macOS will refuse the first launch of an unsigned app downloaded from
elsewhere — right-click the app and choose Open, once, to get the "open anyway" prompt.
"""
from pathlib import Path

from PyInstaller.utils.hooks import collect_all, collect_data_files, collect_submodules

ROOT = Path(SPECPATH).resolve().parent          # .../RAATPackv3
BACKEND = ROOT / "backend"
DIST_FE = ROOT / "frontend" / "dist"
SAMPLES = ROOT.parent / "Demo Data"             # the v2 demo set, shipped as sample data
ICON = ROOT / "build" / "icon.icns"

VERSION = "3.0.0"
for line in (BACKEND / "raatpack" / "__init__.py").read_text().splitlines():
    if line.startswith("__version__"):
        VERSION = line.split("=", 1)[1].strip().strip('"').strip("'")
        break

if not (DIST_FE / "index.html").exists():
    raise SystemExit(
        f"frontend/dist not found at {DIST_FE}.\n"
        "Build the interface first:  cd frontend && npm ci && npm run build"
    )

# --- data shipped inside the bundle -------------------------------------------------
# raatpack.config.settings.bundle_dir() resolves to sys._MEIPASS when frozen, and expects
# these paths relative to it.
datas = [
    (str(BACKEND / "data" / "templates"), "data/templates"),
    (str(DIST_FE), "frontend_dist"),
]

# The sample data behind the "Load sample data" button, laid out exactly as the repository
# holds it so raatpack.config.samples resolves the same folder names either way.
if SAMPLES.is_dir():
    datas.append((str(SAMPLES), "data/samples"))
else:
    print(f"WARNING: sample data not found at {SAMPLES}; "
          f"the Load sample data button will be disabled in this build.")

binaries = []
hiddenimports = collect_submodules("raatpack")

# uvicorn/starlette resolve these dynamically at runtime.
hiddenimports += [
    "uvicorn.logging", "uvicorn.loops", "uvicorn.loops.auto",
    "uvicorn.protocols", "uvicorn.protocols.http", "uvicorn.protocols.http.auto",
    "uvicorn.protocols.http.h11_impl", "uvicorn.protocols.websockets",
    "uvicorn.protocols.websockets.auto", "uvicorn.lifespan", "uvicorn.lifespan.on",
    "multipart", "multipart.multipart",
    "scipy.special._ufuncs_cxx", "scipy._lib.messagestream",
    "scipy.optimize", "scipy.stats",
    "matplotlib.backends.backend_pdf", "matplotlib.backends.backend_agg",
    "openpyxl.chart",
    "PIL.Image",                       # openpyxl needs Pillow to place the logo
]

# pywebview ships JS assets and platform backends that are imported by name.
for pkg in ("webview",):
    d, b, h = collect_all(pkg)
    datas += d
    binaries += b
    hiddenimports += h
# On macOS the window is system WebKit, reached through pyobjc.
hiddenimports += ["webview.platforms.cocoa", "objc", "Foundation", "AppKit", "WebKit", "Quartz"]
for pkg in ("objc", "Foundation", "AppKit", "WebKit"):
    try:
        d, b, h = collect_all(pkg)
        datas += d
        binaries += b
        hiddenimports += h
    except Exception as exc:               # pyobjc not installed: the app falls back to a browser
        print(f"WARNING: could not collect {pkg} ({exc}); the native window may be unavailable.")

datas += collect_data_files("matplotlib")

a = Analysis(
    [str(BACKEND / "raatpack" / "desktop.py")],
    pathex=[str(BACKEND)],
    binaries=binaries,
    datas=datas,
    hiddenimports=hiddenimports,
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=["tkinter", "PyQt5", "PyQt6", "PySide2", "PySide6", "IPython", "notebook", "pytest"],
    noarchive=False,
)

pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    [],
    exclude_binaries=True,
    name="RAATPack",
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=False,
    console=False,                 # no terminal; see the log file in the data folder
    disable_windowed_traceback=False,
    argv_emulation=False,          # we take no file arguments from Finder
    target_arch=None,              # build for whatever Mac this runs on
    codesign_identity=None,
    entitlements_file=None,
)

coll = COLLECT(
    exe,
    a.binaries,
    a.datas,
    strip=False,
    upx=False,
    upx_exclude=[],
    name="RAATPack",
)

app = BUNDLE(
    coll,
    name="RAATPack.app",
    icon=str(ICON) if ICON.exists() else None,
    bundle_identifier="edu.rutgers.cait.raatpack",
    version=VERSION,
    info_plist={
        "CFBundleName": "RAAT-Pack",
        "CFBundleDisplayName": "RAAT-Pack",
        "CFBundleShortVersionString": VERSION,
        "CFBundleVersion": VERSION,
        "NSHumanReadableCopyright": "Rutgers Asphalt Pavement Laboratory",
        "LSMinimumSystemVersion": "11.0",
        "NSHighResolutionCapable": True,
        # One window, and quitting it quits the application — the server is a thread inside
        # this process, so leaving the process alive after the window closes would strand it.
        "LSUIElement": False,
        "LSApplicationCategoryType": "public.app-category.productivity",
        # The app talks only to 127.0.0.1; this keeps macOS from blocking that as cleartext.
        "NSAppTransportSecurity": {"NSAllowsLocalNetworking": True},
    },
)
